<?xml version='1.0' encoding='utf-8'?>
<diff>
  <add sel="//set_value[@name='$HQPosition']" pos="before">
    <find_sector name="$HQSectorHE" macro="macro.cluster_31_sector001_macro" comment="Heretic's End, the new HQ sector"/>
  </add>
  <replace sel="//cue[@name='Initialise']/actions/do_if/@value">player.module == 'x4ep1_gamestart_boron2' or player.module == 'x4ep1_gamestart_scientist' or $story_hq_boso or $story_hq_dal</replace>
  <replace sel="//cue[@name='Initialise']/actions/do_if/do_if[1]/@value">player.module == 'x4ep1_gamestart_boron2' or player.module == 'x4ep1_gamestart_scientist'</replace>
  <replace sel="//do_if[1]/find_station_by_true_owner/@space">player.galaxy</replace>
  <remove sel="//cue[@name='Initialise']/actions/do_elseif"/>
  <replace sel="//cue[@name='Initialise']/actions/do_else/set_value">
    <signal_cue cue="Phase_BosoOffer"/>
  </replace>
  <remove sel="//signal_cue[@cue='Phase_SignalLeak']"/>
  <remove sel="//cue[@name='SignalLeak_Hint_Message']"/>
  <remove sel="//cue[@name='Phase_SignalLeak_Cancelled']"/>
  <replace sel="//cue[@name='Phase_SignalLeak']/@name">Phase_BosoOffer</replace>
  <add sel="//cue[@name='Phase_BosoOffer']/actions/include_actions" pos="after">
    <create_offer cue="Phase_BosoOffer" actor="$Boron_Mentor" name="{30201,100}" description="{30201,101}" type="missiontype.plot" group="missiongroup.story_boso" faction="faction.civilian" difficulty="level.easy">
      <briefing>
        <objective step="1" action="objective.contact" text="{30201,2}"/>
      </briefing>
    </create_offer>
  </add>
  <add sel="//cue[@name='Phase_BosoOffer']/actions/create_offer" pos="after">
    <write_incoming_message title="{30201,100}" text="{30201,101}" source="{30201,2}" object="$Boron_Mentor" highpriority="true" interaction="guidance"/>
  </add>
  <replace sel="//cue[@name='Phase_SignalLeak_Init']/@name">Phase_BosoOffer_Accepted</replace>
  <add sel="//cue[@name='Phase_BosoOffer_Accepted']/actions" pos="before">
    <conditions>
      <check_any>
        <event_object_signalled object="$Boron_Mentor" param="'accept'"/>
        <check_all>
          <event_conversation_next_section actor="$Boron_Mentor" choiceparam="Phase_BosoOffer"/>
          <check_value value="event.param == 'c_mission_accept'"/>
        </check_all>
      </check_any>
    </conditions>
  </add>
  <replace sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/create_group">
    <do_if value="not $MissionCue.hasmission">
      <remove_offer cue="Phase_BosoOffer"/>
      <create_mission cue="$MissionCue" name="{30201,200}" description="{30201,201}" type="missiontype.plot" group="missiongroup.story_boso" faction="faction.civilian" difficulty="level.easy" abortable="false" icon="'briefing_boso_ta_02'" iconcaption="{30201,2}">
        <briefing>
          <objective step="1" action="objective.dockat" text="{30201,1002}" comment="Station"/>
          <objective step="2" action="objective.pickup" text="$PickupWare.name"/>
          <objective step="3" action="objective.flyto" text="{30201, 1004}" comment="Scientific area"/>
          <objective step="4" action="objective.custom" customaction="{30201, 1005}" text="{30201,1006}" comment="(Achieve:) Life's work"/>
        </briefing>
      </create_mission>
    </do_if>
  </replace>
  <replace sel="//set_value[@name='$SignalLeakActors']">
    <signal_cue cue="Phase_BosoOffer_Place_Crate"/>
  </replace>
  <remove sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/set_value"/>
  <remove sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/signal_cue[@cue='Phase_SignalLeak_Find_Station']"/>
  <add sel="//cue[@name='Phase_BosoOffer_Accepted']/actions" pos="after">
    <cues>
      <cue name="Phase_BosoOffer_Place_Crate" instantiate="true">
        <conditions>
          <event_cue_signalled/>
        </conditions>
        <actions>
          <set_value name="$CrateSlot" exact="null"/>
          <set_value name="$BosoStation" exact="null"/>
          <do_all exact="2" counter="$pass">
            <do_if value="not $CrateSlot">
              <do_if value="$pass == 1">
                <find_sector_in_range name="$BosoSectors" object="player.sector" mindistance="0" maxdistance="5" distances="$BosoSectorDistances" multiple="true"/>
              </do_if>
              <do_else>
                <find_sector_in_range name="$BosoSectors" object="$HQSector" mindistance="3" maxdistance="6" distances="$BosoSectorDistances" multiple="true"/>
              </do_else>
              <set_value name="$SortedBosoSectors" exact="$BosoSectorDistances.keys.sorted"/>
              <do_all exact="$SortedBosoSectors.count" counter="$s">
                <do_if value="not $CrateSlot and $SortedBosoSectors.{$s}.extension == ''">
                  <find_station name="$BosoStations" space="$SortedBosoSectors.{$s}" multiple="true">
                    <match_relation_to object="player.entity" comparison="not" relation="enemy"/>
                    <match owner="[faction.player, faction.xenon, faction.khaak]" negate="true"/>
                    <match_content class="class.dockarea" min="1" checkoperational="true"/>
                  </find_station>
                  <do_all exact="$BosoStations.count" counter="$t">
                    <do_if value="not $CrateSlot">
                      <find_object_component name="$BosoStationModules" class="class.walkablemodule" object="$BosoStations.{$t}" multiple="true"/>
                      <do_all exact="$BosoStationModules.count" counter="$i">
                        <do_if value="not $CrateSlot">
                          <find_crate_slot name="$CrateSlot" object="$BosoStationModules.{$i}" tags="tag.crate_s"/>
                        </do_if>
                      </do_all>
                      <do_if value="$CrateSlot">
                        <set_value name="$BosoStation" exact="$BosoStations.{$t}"/>
                      </do_if>
                    </do_if>
                  </do_all>
                </do_if>
              </do_all>
            </do_if>
          </do_all>
          <do_if value="$CrateSlot">
            <create_crate name="$Crate" macro="macro.crate_gen_s_01_macro" slot="$CrateSlot"/>
            <add_cargo object="$Crate" ware="$PickupWare" exact="1"/>
            <set_objective cue="$MissionCue" step="2" action="objective.pickup" object="$Crate" text="$PickupWare.name"/>
          </do_if>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Start_Conversation">
        <delay exact="3s"/>
        <actions>
          <start_conversation actor="$Boron_Mentor" conversation="introduction" priority="100"/>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Premature_Conversation_End">
        <conditions>
          <event_conversation_finished actor="$Boron_Mentor"/>
        </conditions>
        <actions/>
      </cue>
      <cue name="Phase_BosoOffer_Conversation_Section_1">
        <conditions>
          <event_conversation_started actor="$Boron_Mentor" conversation="introduction"/>
        </conditions>
        <actions>
          <debug_text text="player.age + ' Plot introduction conversation started with ' + $Boron_Mentor + ' ' + $Boron_Mentor.knownname" chance="$DebugChance"/>
          <allow_conversation_escape enabled="false"/>
          <add_npc_line speaker="$Boron_Mentor" line="30201003" hidechoices="true" comment="Ah, that should do it. I had to disable my voice filter. I was beginning to think my messages were being intercepted by those Split fellows. I'm a little disappointed that this was so easy."/>
          <add_npc_line speaker="$Boron_Mentor" line="30201004" hidechoices="true" delay="0.3s" comment="I don't suppose they sent you did they? Oh, that would be quite devious."/>
          <add_player_choice text="{1002,3020101}" section="who_are_they"/>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Conversation_Section_2">
        <conditions>
          <event_conversation_next_section actor="$Boron_Mentor" section="who_are_they"/>
        </conditions>
        <actions>
          <allow_conversation_escape enabled="false"/>
          <add_npc_line speaker="$Boron_Mentor" line="30201006" hidechoices="true" comment="Hmm, what should I call them. I suppose captors is quite apt. Employers? They let me work on my own projects some days you see."/>
          <add_player_choice text="{1002,3020102}" section="do_you_need_help" comment="Do you need help?"/>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Conversation_Section_3">
        <conditions>
          <event_conversation_next_section actor="$Boron_Mentor" section="do_you_need_help"/>
        </conditions>
        <actions>
          <allow_conversation_escape enabled="false"/>
          <add_npc_line speaker="$Boron_Mentor" line="30201007" hidechoices="true" comment="Ah, yes. You see, I'm in a spot of bother. I am in the middle of some important scientific research which I'm unable to pursue personally from my current location. I'm looking for an assistant to aid me."/>
          <add_player_choice text="{1002,3020104}" section="player_more_info"/>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Conversation_More_Info">
        <conditions>
          <event_conversation_next_section actor="$Boron_Mentor" section="player_more_info"/>
        </conditions>
        <actions>
          <allow_conversation_escape enabled="false"/>
          <debug_text text="player.age + ' Player to see briefing'" chance="$DebugChance"/>
          <add_npc_line speaker="$Boron_Mentor" line="30201009" hidechoices="true" comment="I'll send the task to your ship computer. This is rather exciting!"/>
          <cancel_cue cue="Phase_BosoOffer_Premature_Conversation_End"/>
          <speak actor="$Boron_Mentor" priority="100" line="30201010" comment="Wonderful! I have managed to place the device on a nearby docking area. You should be getting the coordinates now."/>
        </actions>
      </cue>
      <cue name="Phase_BosoOffer_Crate_Collected">
        <conditions>
          <event_player_opened_crate crate="$Crate"/>
        </conditions>
        <actions>
          <debug_text text="player.age + ' - Collected crate'" chance="$DebugChance"/>
          <set_objective action="objective.none" cue="$MissionCue"/>
          <cancel_cue cue="Phase_BosoOffer_Crate_Lost"/>
        </actions>
        <cues>
          <cue name="Phase_BosoOffer_Crate_Collected_Delay">
            <delay exact="1s"/>
            <actions>
              <set_value name="Mentor_Speak_Helper.$Lines" exact="[[30201011, 0s], [30201012, 2s], [30201016, 1s]]"/>
              <signal_cue cue="Mentor_Speak_Helper"/>
            </actions>
          </cue>
          <cue name="Phase_BosoOffer_Crate_Collected_End">
            <conditions>
              <event_speak_finished actor="$Boron_Mentor" line="30201016"/>
            </conditions>
            <actions>
              <signal_cue cue="Phase_TheAnomaly"/>
            </actions>
          </cue>
        </cues>
      </cue>
    </cues>
  </add>
  <replace sel="//cue[@name='Phase_SignalLeak_Reset_Helper']">
    <cue name="Phase_BosoOffer_Crate_Lost">
      <conditions>
        <event_object_destroyed object="$Crate"/>
      </conditions>
      <actions>
        <signal_cue cue="Phase_BosoOffer_Place_Crate"/>
      </actions>
    </cue>
  </replace>
  <remove sel="//cue[@name='Phase_SignalLeak_Find_Station']"/>
</diff>
